#define WIFI_SSID       "YourNetwork"
#define WIFI_PASSWORD   "your-wifi-password"

// MQTT broker — the Pi Zero 2 W running Mosquitto.
#define MQTT_BROKER     "192.168.1.42"
#define MQTT_PORT       1883
#define MQTT_USER       "wildlife"
#define MQTT_PASSWORD   "your-broker-password"

// Unique identifier for this camera node. Used in topic names and DB rows.
